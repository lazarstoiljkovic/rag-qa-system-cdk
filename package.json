{
  "name": "rag-qa-system-cdk",
  "version": "1.0.0",
  "description": "RAG-based Q&A System using AWS Bedrock Knowledge Base and Custom OpenSearch with CDK",
  "bin": {
    "rag-qa-system-cdk": "bin/rag-qa-system-cdk.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy:knowledge-base": "cdk deploy KnowledgeBaseStack",
    "deploy:opensearch": "cdk deploy CustomOpenSearchStack",
    "deploy:all": "cdk deploy --all",
    "destroy:all": "cdk destroy --all"
  },
  "keywords": [
    "aws",
    "cdk",
    "rag",
    "llm",
    "bedrock",
    "opensearch",
    "qa-system"
  ],
  "author": "Lazar Stoiljkovic",
  "license": "MIT",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.136",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "aws-cdk": "^2.126.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent": "^3.511.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.511.0",
    "@aws-sdk/client-bedrock-runtime": "^3.511.0",
    "@aws-sdk/client-dynamodb": "^3.511.0",
    "@aws-sdk/client-opensearch": "^3.511.0",
    "@aws-sdk/client-s3": "^3.511.0",
    "@aws-sdk/lib-dynamodb": "^3.511.0",
    "@opensearch-project/opensearch": "^2.5.0",
    "aws-cdk-lib": "^2.126.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
